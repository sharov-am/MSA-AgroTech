@startuml Архитектура_АгроТех_Системы_v4

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml


AddSystemTag("bgcolor", $bgColor="#ed0fd3ff")

' === Участники ===
Person(директор, "Директор хозяйства", "Управление через веб-портал")
Person(аналитик, "Аналитик", "Работа с BI-системой")
Person(фермер, "Фермер", "Управление фермой")

System_Boundary(платформа, "Ферма Х - Цифровая платформа") {
       Container_Boundary(edge_сервисы, "Edge сервисы для мониторинга животных" ) {
        Container(мониторинг_поведения_животных, "Мониторинг поведения животных", $tags="bgcolor")
        Container(инфраструктура_фермы, "Мониторинг и управления  инфраструктурой", $tags="bgcolor")        
        Container(состояние_и_учет, "Состояния и учет животных", $tags="bgcolor")
        Container(модем, "Для надежной отправки сообщений", $tags="bgcolor")
    }
    
    Container_Boundary(централизованные_сервисы, "Централизованные сервисы для управления фермой" ) {
        Container(метрики, "Сбор и экспорт метрик", $tags="bgcolor")
        Container(авторизация, "Авторизация пользователей", $tags="bgcolor")
        Container(kafka, "Брокер сообщений", "Apache Kafka", "Шина данных")
        
        Container_Boundary(iot_платформа, "IoT платформа") {
                   Container(iot_шлюз, "IoT шлюз", "Node-RED", "Сбор данных с ферм")
                   ContainerDb(tsdb1, "База временных рядов для тенанта 1", "TimescaleDB for tenant1", "Данные датчиков")
                   ContainerDb(tsdbN, "База временных рядов для тенанта N", "TimescaleDB for tenantN", "Данные датчиков")
                   
       }

        Container(tenant_to_data_mapping, "Отображение тенанта к соотв. бд", "Tenant to db", "Строка подключения к соотв. базам",$tags="bgcolor")
        
        Container(веб_портал, "Веб-портал", "React", "Управление хозяйством")
        Container(мобильное_приложение, "Мобильное приложение", "Flutter", "Полевые работы")
        ContainerDb(erp, "ERP система (1С:Агро)", "1С", "Финансы, склад, кадры")
                 
        Container_Boundary(данные1, "Хранилища данных тенанта 1") {
           ContainerDb(data_lake1, "Data Lake", "MinIO", "Сырые данные (S3-совместимое)")
           ContainerDb(dwh1, "Data Warehouse", "ClickHouse", "Структурированные данные")       
        }

        Container_Boundary(данныеN, "Хранилища данных тенанта N") {
           ContainerDb(data_lakeN, "Data Lake", "MinIO", "Сырые данные (S3-совместимое)")
           ContainerDb(dwhN, "Data Warehouse", "ClickHouse", "Структурированные данные")       
        }

    
    Container(bi, "BI система", "Power BI", "Отчеты и визуализация")
    Container(аналитика, "Аналитический модуль", "Python+Spark", "Анализ эффективности")

    Container(billing, "Биллинг", $tags="bgcolor")

    }
}
System_Boundary(pay_systems, "Платежные системы"){
    Container(ps1,"Платежная система 1")
    Container(ps2,"Платежная система 2")
    Container(ps3,"Платежная система 3")
}
  



' === Взаимосвязи ===
Rel(директор, веб_портал, "Использует")
Rel(аналитик, bi, "Анализирует")
Rel(фермер, веб_портал, "Использует")
Rel(фермер, мобильное_приложение, "Использует")

' Центральная Kafka
Rel(iot_шлюз, kafka, "Публикует данные", "Kafka Protocol")
Rel(kafka, data_lake1, "Сырые данные", "Kafka Connect+S3")
Rel(kafka, dwh1, "Трансформированные данные", "ETL+Airflow")
Rel(kafka, data_lakeN, "Сырые данные", "Kafka Connect+S3")
Rel(kafka, dwhN, "Трансформированные данные", "ETL+Airflow")



' Аналитика
Rel(аналитика,tenant_to_data_mapping ,"Доступ к сырым данным", "Spark")
Rel(аналитика, data_lake1, "Доступ к сырым данным", "Spark")
Rel(аналитика, data_lakeN, "Доступ к сырым данным", "Spark")
Rel(аналитика, dwh1, "Доступ к структурированным данным", "SQL")
Rel(аналитика, dwhN, "Доступ к структурированным данным", "SQL")



Rel(аналитика, bi, "Передает отчеты", "ODBC")
Rel(аналитика, веб_портал, "Формирует рекомендации", "WebSocket")

' ERP интеграция
Rel(веб_портал, erp, "Синхронизация данных", "REST API")
Rel(erp, dwh1, "Бизнес-данные тенанта 1", "ETL")
Rel(erp, dwhN, "Бизнес-данные тенанта N", "ETL")
Rel(мобильное_приложение, kafka, "Полевые отчеты", "Kafka Protocol")

' Фермерские системы
Rel(веб_портал, авторизация, "Использует")
Rel(мониторинг_поведения_животных, iot_шлюз, "Передает данные", "LoRaWAN")
Rel(состояние_и_учет, iot_шлюз, "Передает данные", "LoRaWAN")
Rel(инфраструктура_фермы, iot_шлюз, "Передает данные", "LoRaWAN")
Rel(мобильное_приложение, авторизация, "Использует")
Rel(мониторинг_поведения_животных, модем, "Передает данные", "mqtt")
Rel(состояние_и_учет, модем, "Передает данные", "mqtt")
Rel(инфраструктура_фермы, модем, "Передает данные", "mqtt")

Rel(метрики, tenant_to_data_mapping, "Запрашивает строку подключения")
Rel(метрики, tsdb1, "Передает или запрашивает метрики")
Rel(метрики, tsdbN, "Передает или запрашивает метрики")

Rel(авторизация, tenant_to_data_mapping, "Авторизация и получение соотв. строк подключения к бд")

' Биллинг
Rel(billing, kafka, "Получает данные от")
Rel(billing, tenant_to_data_mapping,"Получает строку подключения")
Rel(billing, данные1, "Получает данные от")
Rel(billing, данныеN,"Получает данные от")

Rel(billing, pay_systems,"Запрашивает данные","Синхронный вызов")

Rel(веб_портал, billing,"Использует")
Rel(мобильное_приложение, billing,"Использует")

@enduml