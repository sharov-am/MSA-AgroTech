@startuml Архитектура_АгроТех_Системы_v4

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
!include <C4/C4_Component>

AddSystemTag("bgcolor", $bgColor="#ed0fd3ff")

' === Участники ===
Person(директор, "Директор хозяйства", "Управление через веб-портал")
Person(аналитик, "Аналитик", "Работа с BI-системой")
Person(фермер, "Фермер", "Управление фермой")

System_Boundary(платформа, "Ферма Х - Цифровая платформа") {
        Container_Boundary(edge_сервисы, "Edge сервисы для мониторинга животных" ) {
        
        Container(мониторинг_поведения_животных, "Мониторинг поведения животных", $tags="bgcolor") {
            Component(video_capture_module, "Захват и обработка видео от камеры для передачи в процессинг")
            Component(nn_detection_module, "Трекинг поведения животных")
            Component(communication_module_1, "Сервис коммуникаций")
            Component(camera_health_check_module_1, "Сервис проверки камеры","периодически опрашивает камеру")
        }
        Container(инфраструктура_фермы, "Мониторинг и управления  инфраструктурой", $tags="bgcolor"){
            Component(feed_module, "Управление кормушкой")
            Component(water_module, "Управление поилками")
            Component(water_quality_module, "Управление фильтрацией воды")
            Component(food_supply_module, "Управление запасами еды")            
            Component(communication_module_2, "Сервис коммуникаций")
            Component(device_health_check_module, "Сервис проверки подключенных устройств","периодически опрашивает")
        }        
        Container(состояние_и_учет, "Состояния и учет животных", $tags="bgcolor"){
            Component(health_module, "Модуль состояния животных")
            Component(counter_module, "Модуль пересчета животных")
            Component(communication_module_3, "Сервис коммуникаций")
            Component(camera_health_check_module_2, "Сервис проверки камеры")
        }
        Container(модем, "Для надежной отправки сообщений", $tags="bgcolor"){
            Component(modem_health_check_module, "Сервис проверки камеры")
            Component(send_receive_module, "Сервис для надежной коммуникации через модем")
        }
    }
    
    Container_Boundary(централизованные_сервисы, "Централизованные сервисы для управления фермой" ) {
       
        Container(метрики, "Сбор и экспорт метрик", $tags="bgcolor"){
            Component(metrics_module, "Сервис управления метриками")            
        }
        Container(авторизация, "Аутентификации и авторизации", $tags="bgcolor"){
            Component(auth_module, "Сервис аутентификации и авторизации")
        }
        Container(kafka, "Брокер сообщений", "Apache Kafka", "Шина данных")
        
        Container_Boundary(iot_платформа, "IoT платформа") {
                   Container(iot_шлюз, "IoT шлюз", "Node-RED", "Сбор данных с ферм")
                   Container(tsdb, "База временных рядов", "TimescaleDB", "Данные датчиков")
       }

        Container(веб_портал, "Веб-портал", "React", "Управление хозяйством")
        Container(мобильное_приложение, "Мобильное приложение", "Flutter", "Полевые работы")
        ContainerDb(erp, "ERP система (1С:Агро)", "1С", "Финансы, склад, кадры")
                 
        Container_Boundary(данные, "Хранилища данных") {
           ContainerDb(data_lake, "Data Lake", "MinIO", "Сырые данные (S3-совместимое)")
           ContainerDb(dwh, "Data Warehouse", "ClickHouse", "Структурированные данные")
    }
    
    Container(bi, "BI система", "Power BI", "Отчеты и визуализация")
    Container(аналитика, "Аналитический модуль", "Python+Spark", "Анализ эффективности")
    }
}


' === Взаимосвязи ===
Rel(директор, веб_портал, "Использует")
Rel(аналитик, bi, "Анализирует")
Rel(фермер, веб_портал, "Использует")
Rel(фермер, мобильное_приложение, "Использует")

' Центральная Kafka
Rel(iot_шлюз, kafka, "Публикует данные", "Kafka Protocol")
Rel(kafka, data_lake, "Сырые данные", "Kafka Connect+S3")
Rel(kafka, dwh, "Трансформированные данные", "ETL+Airflow")


' Аналитика
Rel(data_lake, аналитика, "Доступ к сырым данным", "Spark")
Rel(dwh, аналитика, "Доступ к структурированным данным", "SQL")
Rel(аналитика, bi, "Передает отчеты", "ODBC")
Rel(аналитика, веб_портал, "Формирует рекомендации", "WebSocket")

' ERP интеграция
Rel(веб_портал, erp, "Синхронизация данных", "REST API")
Rel(erp, dwh, "Бизнес-данные", "ETL")
Rel(мобильное_приложение, kafka, "Полевые отчеты", "Kafka Protocol")

' Фермерские системы
Rel(веб_портал, авторизация, "Использует")
Rel(мониторинг_поведения_животных, iot_шлюз, "Передает данные", "LoRaWAN")
Rel(состояние_и_учет, iot_шлюз, "Передает данные", "LoRaWAN")
Rel(метрики, tsdb, "Передает или запрашивает метрики")
Rel(инфраструктура_фермы, iot_шлюз, "Передает данные", "LoRaWAN")
Rel(мобильное_приложение, авторизация, "Использует")
Rel(мониторинг_поведения_животных, модем, "Передает данные", "mqtt")
Rel(состояние_и_учет, модем, "Передает данные", "mqtt")
Rel(инфраструктура_фермы, модем, "Передает данные", "mqtt")

'сервис мониторинга_поведения_животных
Rel(video_capture_module, nn_detection_module, "передает картинки")
Rel(nn_detection_module, communication_module_1, "передает данные","mqtt")
Rel(camera_health_check_module_1, communication_module_1, "передает данные в случае проблем")
Rel(communication_module_1, iot_шлюз, "передает данные","LoRWAN или модем")

'инфраструктура_фермы
Rel(feed_module, communication_module_2, "передает данные", "mqtt")
Rel(water_module, communication_module_2, "передает данные", "mqtt")
Rel(water_quality_module, communication_module_2, "передает данные", "mqtt")
Rel(food_supply_module, communication_module_2, "передает данные", "mqtt")
Rel(communication_module_2, iot_шлюз, "передает данные","LoRWAN или модем")

'состояние_и_учет  
 Rel(health_module, communication_module_3, "передает данные", "mqtt")
 Rel(counter_module, communication_module_3, "передает данные", "mqtt")
 Rel(camera_health_check_module_1, communication_module_3, "передает данные в случае проблем")
 Rel(communication_module_3, iot_шлюз, "передает данные","LoRWAN или модем")
 
@enduml