    System(полевые_данные, "Данные с полей")
    System(управление_техникой, "Управление техникой") 
    System(данные, "Хранилища данных") 
    System(аналитика, "Аналитический модуль",  "Анализ эффективности")
      
}
System(модуль_фермы, "Новый, фермерский модуль")

